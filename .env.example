# Copy to .env and fill in real values. Never commit .env.
DJANGO_SECRET_KEY=replace-with-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL (the role needs LOGIN and CREATEDB; CREATEDB lets Django create the test database)
DB_NAME=NBG
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# MQTT simulator (assessment-supplied values)
MQTT_HOST=152.42.238.142
MQTT_PORT=1883
MQTT_CANDIDATE_ID=15
MQTT_KEEPALIVE=30
